\begin_inset Formula 
\begin{align*}
\hat{\boldsymbol{\mathbf{w}}}= & \text{arg}\min_{\mathbf{\mathbf{w}}\in\mathbb{R}^{d+1}}\frac{1}{N}\sum^{N}_{i=1}(y_{i}-\mathbf{w}'\tilde{\phi}(\mathbf{x}_{i}))^{2}\\
= & \text{arg}\min_{\mathbf{\mathbf{w}}\in\mathbb{R}^{d+1}}\frac{1}{N}\left(\mathbf{y}-X\mathbf{w}\right)'\left(\mathbf{y}-X\mathbf{w}\right),
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
where 
\begin_inset Formula $\tilde{\phi}(\mathbf{x}_{i})=\begin{bmatrix}\phi(\mathbf{x}_{i}) & 1\end{bmatrix}'\in\mathbb{R}^{d+1}$
\end_inset

