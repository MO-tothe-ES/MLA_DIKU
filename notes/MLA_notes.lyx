\begin_layout Section

\lang american
Concentration of measure inequalities
\end_layout

\begin_layout Subsection

\lang american
Markow's inequality
\end_layout

\begin_layout Standard

\series bold
\lang american
Statement
\series default
:
 For any non-negative stochastic variable 
\begin_inset Formula $X$
\end_inset

 and with 
\begin_inset Formula $\epsilon>0$
\end_inset

 we have 
\begin_inset Formula 
\[
\mathbb{P}(X\geq\epsilon)\leq\frac{\mathbb{E}[X]}{\epsilon}.
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
\lang american
Proof
\series default
:
 Define 
\begin_inset Formula $Y:=1(X\geq\epsilon)$
\end_inset

 then 
\begin_inset Formula $Y\leq\frac{X}{\epsilon}$
\end_inset

 (if 
\begin_inset Formula $0\leq X<\epsilon$
\end_inset

 then 
\begin_inset Formula $Y=0\leq\frac{X}{\epsilon}$
\end_inset

 and if 
\begin_inset Formula $X\geq\epsilon\iff\frac{X}{\epsilon}\geq1$
\end_inset

 then 
\begin_inset Formula $Y=1\leq\frac{X}{\epsilon}$
\end_inset

) therefore 
\begin_inset Formula $\mathbb{P}(X\geq\epsilon)=\mathbb{P}(Y=1)=\mathbb{E}[Y]\leq\mathbb{E}[\frac{X}{\epsilon}]=\frac{\mathbb{E}[X]}{\epsilon}$
\end_inset

.
\end_layout

\begin_layout Standard

\lang american
This can be rewritten by defining 
\begin_inset Formula $a=\frac{\epsilon}{\mathbb{E}[X]}$
\end_inset

 (
\begin_inset Formula $\mathbb{E}[X]\neq0$
\end_inset

) and we have 
\begin_inset Formula 
\[
\mathbb{P}(X\geq a\mathbb{E}[X])\leq\frac{1}{a}
\]

\end_inset

.
 That is,
 the probability of an event 
\begin_inset Formula $a$
\end_inset

 times away from the stochastic variables mean value is decaying with 
\begin_inset Formula $1/a$
\end_inset

.
\end_layout

\begin_layout Subsection

\lang american
Chebychew's inequality
\end_layout

\begin_layout Standard

\series bold
\lang american
Statement
\series default
:
 
\begin_inset Formula 
\[
\mathbb{P}(|X-\mathbb{E}[X]|\geq\epsilon)\leq\frac{\mathbb{V}(X)}{\epsilon^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
\lang american
Proof
\series default
:
 For any 
\begin_inset Formula $\epsilon>0$
\end_inset

 we have (by Markow's inequality) 
\begin_inset Formula $\mathbb{P}((X-\mathbb{E}[X])^{2}\geq\epsilon^{2})\leq\frac{\mathbb{E}[(X-\mathbb{E}[X])^{2}]}{\epsilon^{2}}=\frac{\mathbb{V}(X)}{\epsilon^{2}}$
\end_inset

.
 Finally we note that 
\series bold

\begin_inset Formula $|X-\mathbb{E}[X]|\geq\epsilon\iff(X-\mathbb{E}[X])^{2}\geq\epsilon^{2}$
\end_inset

 
\series default
and thus
\series bold
 
\series default

\begin_inset Formula $\mathbb{P}(|X-\mathbb{E}[X]|\geq\epsilon)\leq\frac{\mathbb{V}(X)}{\epsilon^{2}}$
\end_inset

.
\end_layout

\begin_layout Subsection

\lang american
Hoeffding's inequality
\end_layout

\begin_layout Standard

\series bold
\lang american
Statement
\series default
:
 Given the independent stochastic variables 
\begin_inset Formula $X_{1},\dots,X_{n}$
\end_inset

 where there exists 
\begin_inset Formula $a_{i,}b_{i}$
\end_inset

 for 
\begin_inset Formula $i\in\{1,\dots,n\}$
\end_inset

 such that 
\begin_inset Formula $X_{i}\in[a_{i},b_{i}]$
\end_inset

.
 For all 
\begin_inset Formula $\epsilon>0$
\end_inset

,
\begin_inset Formula 
\[
\mathbb{P}\left(\sum^{n}_{i=1}X_{i}-\mathbb{E}\left[\sum^{n}_{i=1}X_{i}\right]\geq\epsilon\right)\leq e^{-\frac{2\epsilon^{2}}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}}.
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
\lang american
Proof
\series default
:
 
\end_layout

\begin_layout Standard

\lang american
\begin_inset Formula 
\begin{align*}
\mathbb{P}\left(\sum^{n}_{i=1}X_{i}-\mathbb{E}\left[\sum^{n}_{i=1}X_{i}\right]\geq\epsilon\right) & =\mathbb{P}\left(e^{\lambda\left(\sum^{n}_{i=1}X_{i}-E\left(\sum^{n}_{i=1}X_{i}\right)\right)}\geq e^{\lambda\epsilon}\right)\\
 & \leq\frac{E\left[e^{\lambda\left(\sum^{n}_{i=1}X_{i}-E\left(\sum^{n}_{i=1}X_{i}\right)\right)}\right]}{e^{\lambda\epsilon}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
The nominator can be reduced.
 Firstly we use that the expectation operator is linear so that 
\begin_inset Formula $\mathbb{E}\left(\sum^{n}_{i=1}X_{i}\right)=\sum^{n}_{i=1}\mathbb{E}[X_{i}]$
\end_inset


\end_layout

\begin_layout Standard

\lang american
\begin_inset Formula 
\begin{align*}
\mathbb{E}\left[e^{\lambda\left(\sum^{n}_{i=1}X_{i}-\mathbb{E}\left(\sum^{n}_{i=1}X_{i}\right)\right)}\right] & =\mathbb{E}\left[e^{\lambda\left(\sum^{n}_{i=1}X_{i}-\sum^{n}_{i=1}\mathbb{E}[X_{i}]\right)}\right]\\
 & =\mathbb{E}\left[e^{\lambda\sum^{n}_{i=1}(X_{i}-\mathbb{E}[X_{i}])}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
Now using the properties of the exponential function and Hoeffdings lemma (proof will follow)
\begin_inset Formula 
\begin{align*}
\mathbb{E}\left[e^{\lambda\sum^{n}_{i=1}X_{i}-\mathbb{E}[X_{i}]}\right] & =\mathbb{E}\left[\prod^{n}_{i=1}e^{\lambda(X_{i}-\mathbb{E}[X_{i}])}\right]\\
 & =\prod^{n}_{i=1}E\left[e^{\lambda(X_{i}-\mathbb{E}[X_{i}])}\right]\\
 & \leq\prod^{n}_{i=1}e^{\lambda^{2}(b_{i}-a_{i})^{2}/8}\\
 & =e^{\lambda^{2}/8\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
Taking stock:
 so far we have
\begin_inset Formula 
\[
\mathbb{P}\left(\sum^{n}_{i=1}X_{i}-\mathbb{E}\left(\sum^{n}_{i=1}X_{i}\right)\geq\epsilon\right)\leq e^{\lambda^{2}/8\sum^{n}_{i=1}(b_{i}-a_{i})^{2}-\lambda\epsilon}.
\]

\end_inset


\end_layout

\begin_layout Standard

\lang american
However we want the tightest probability bound,
 and therefore we minimize the right hand side expression wrt.
 
\begin_inset Formula $\lambda>0.$
\end_inset


\begin_inset Formula 
\[
\lambda^{*}=\text{arg }\min_{\lambda}\enspace e^{\lambda^{2}/8\sum^{n}_{i=1}(b_{i}-a_{i})^{2}-\lambda\epsilon}=\text{arg }\min_{\lambda}\,\left\{ \frac{\lambda^{2}}{8}\sum^{n}_{i=1}(b_{i}-a_{i})^{2}-\lambda\epsilon\right\} ,
\]

\end_inset

with necessary first order condition
\begin_inset Formula 
\[
0=\frac{\lambda^{*}}{4}\sum^{n}_{i=1}(b_{i}-a_{i})^{2}-\epsilon\iff\lambda^{*}=\frac{4\epsilon}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}.
\]

\end_inset


\end_layout

\begin_layout Standard

\lang american
Substituting this into the stock-taking expression yields the theorem statement
\begin_inset Formula 
\begin{align*}
e^{(\lambda^{*})^{2}/8\sum^{n}_{i=1}(b_{i}-a_{i})^{2}-\lambda^{*}\epsilon} & =e^{\left(\frac{4\epsilon}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}.\right)^{2}/8\sum^{n}_{i=1}(b_{i}-a_{i})^{2}-\frac{4\epsilon^{2}}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}}\\
 & =e^{\frac{2\epsilon^{2}}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}-\frac{4\epsilon^{2}}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}}\\
 & =e^{-\frac{2\epsilon^{2}}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}.}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
Taken all together we have obtained Hoeffding Inequality:
\begin_inset Formula 
\[
\mathbb{P}\left(\sum^{n}_{i=1}X_{i}-\mathbb{E}\left[\sum^{n}_{i=1}X_{i}\right]\geq\epsilon\right)\leq e^{-\frac{2\epsilon^{2}}{\sum^{n}_{i=1}(b_{i}-a_{i})^{2}}}.
\]

\end_inset


\end_layout

