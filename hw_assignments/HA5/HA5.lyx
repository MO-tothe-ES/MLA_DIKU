 0.,
 -1.],
\end_layout

\begin_layout Plain Layout
                    [2.,
 0.,
 -2.],
\end_layout

\begin_layout Plain Layout
                    [1.,
 0.,
 -1.]]]])
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
# 
\begin_inset Quotes eld
\end_inset

horizontal
\begin_inset Quotes erd
\end_inset

 kernel
\end_layout

\begin_layout Plain Layout
h = torch.tensor([[[[ 1.,
  2.,
  1.],
\end_layout

