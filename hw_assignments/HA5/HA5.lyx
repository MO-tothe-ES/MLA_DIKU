\begin_layout Section
On the Role of Dependence 
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $X_{i}\in\{0,1\}$
\end_inset

,
 
\begin_inset Formula $i\in\{1,2,\dots,n\}$
\end_inset

 be 
\emph on
completely 
\emph default
dependent stochastic variables,
 by which i mean 
\begin_inset Formula 
\[
\mathbb{P}\left(X_{1}=X_{2}=\cdots=X_{n}\right)=1,
\]

\end_inset


\end_layout

\begin_layout Standard
which implies that 
\begin_inset Formula 
\[
\frac{1}{n}\sum^{n}_{i=1}X_{i}=\frac{1}{n}\sum^{n}_{i=1}X_{1}=X_{1}\in\{0,1\}.
\]

\end_inset


\end_layout

\begin_layout Standard
Let the 
\emph on
bias
\emph default
 or 
\emph on
succes probability
\emph default
 of the all the bernoulli random variables be 
\begin_inset Formula $p=\frac{1}{2}$
\end_inset

 (i.e.
 
\begin_inset Formula $\mathbb{P}\left(X_{i}=1\right)=\mathbb{P}\left(X_{i}=0\right)=\frac{1}{2}$
\end_inset

 for all 
\begin_inset Formula $i$
\end_inset

).
 Then calculating the expected value of 
\begin_inset Formula $X_{1}$
\end_inset

 (or any 
\begin_inset Formula $X_{i}$
\end_inset

) yields 
\begin_inset Formula 
\[
\mu\equiv\mathbb{E}\left[X_{1}\right]=\mathbb{P}\left(X_{1}=1\right)=\frac{1}{2},
\]

\end_inset


\end_layout

\begin_layout Standard
and thus we know that 
\begin_inset Formula $\left|\mu-\frac{1}{n}\sum^{n}_{i=1}X_{i}\right|\mid\in\left\{ \frac{1}{2},\frac{1}{2}\right\} $
\end_inset

 and can complete the argument:
 
\begin_inset Formula 
\[
\mathbb{P}\left(\left|\mu-\frac{1}{n}\sum^{n}_{i=1}X_{i}\right|\right)=\mathbb{P}\left(\left|\frac{1}{2}-X_{1}\right|\right)=\frac{1}{2}\geq\frac{1}{2}.
\]

\end_inset


\end_layout

\begin_layout Section
