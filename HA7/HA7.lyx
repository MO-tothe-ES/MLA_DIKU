\begin_layout Subsection
Part 1:
 k-means++ theory
\end_layout

\begin_layout Standard

\lang american
Generally for 
\begin_inset Formula $k$
\end_inset

-means++ the probability that 
\begin_inset Formula $x\in\mathcal{X}$
\end_inset

 is chosen as 
\begin_inset Formula $c_{i}$
\end_inset

 (
\begin_inset Formula $i<k$
\end_inset

) when initial clustering centers 
\begin_inset Formula $S=\{c_{1,2,\dots,i-1}\}$
\end_inset

 are already chosen is 
\begin_inset Formula 
\begin{equation}
\mathbb{P}\left(c_{i}=x\mid\{c_{1,2,\dots,i-1}\}\right)=\frac{D(x,\{c_{1,2,\dots,i-1}\})^{2}}{\sum_{u\in\mathcal{X}}D(u,\{c_{1,2,\dots,i-1}\})^{2}},\label{eq:prob_kmeanpp}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard

\lang american
where 
\begin_inset Formula 
\[
D(x,\{c_{1,2,\dots,i-1}\})=\min_{z\in\{c_{1,2,\dots,i-1}\}}||x-z||_{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\lang american
Therefore in the 
\emph on
small-dataset 
\emph default
with 
\begin_inset Formula $c_{1}=A=(-2,2)$
\end_inset

 and 
\begin_inset Formula $c_{2}=D=(7,-5)$
\end_inset

 already we have (where i only calculate visually ambiguous distances)
\begin_inset Formula 
\begin{align*}
D\left(B,\{A,D\}\right) & =D\left((0,4),\{(-2,2),(7,-5)\}\right)\\
 & =||(0,4)-(-2,2)||\\
 & =\sqrt{8}\\
\\D\left(C,\{A,D\}\right) & =D\left((6,3),\{(-2,2),(7,-5)\}\right)\\
 & =\min\left\{ ||(6,3)-(-2,2)||_{2},||(6,3)-(7,-5)||_{2}\right\} \\
 & =\min\left\{ \sqrt{65},\sqrt{65}\right\} \\
 & =\sqrt{65}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
\begin_inset Formula 
\begin{align*}
D\left(E,\{A,D\}\right) & =D\left((4,-6),\{(-2,2),(7,-5)\}\right)\\
 & =||(4,-6)-(7,-5)||_{2}\\
 & =\sqrt{10}\\
\\D\left(F,\{A,D\}\right) & =D\left((0,-4),\{(-2,2),(7,-5)\}\right)\\
 & =\min\left\{ ||(0,-4)-(-2,2)||_{2},||(0,-4)-(7,-5)||_{2}\right\} \\
 & =\min\left\{ \sqrt{40},\sqrt{50}\right\} \\
 & =\sqrt{40}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
From this we simply apply 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
eqref{eq:prob_kmeanpp}
\end_layout

\end_inset

 yielding the following probability distribution
\begin_inset Formula 
\begin{align*}
\mathbb{P}\left(c_{3}=B\right) & =\frac{8}{123}\\
\mathbb{P}\left(c_{3}=C\right) & =\frac{65}{123}\\
\mathbb{P}\left(c_{3}=E\right) & =\frac{10}{123}\\
\mathbb{P}\left(c_{3}=F\right) & =\frac{40}{123}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\lang american
Note that strictly speaking 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
eqref{eq:prob_kmeanpp}
\end_layout

\end_inset

 also has 
\begin_inset Formula $D\left(A,\{A,D\}\right)+D\left(D,\{A,D\}\right)=0$
\end_inset

 in the denominator.
\end_layout

