\begin_layout Standard
Firstly I rewrite 
\begin_inset Formula $-\ln\left[\mathbb{P}\left(Y=y_{n}\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]$
\end_inset

 where I use the fact that the sample space of the outcome variable is 
\begin_inset Formula $Y\in\{-1,1\}.$
\end_inset


\begin_inset Formula 
\begin{align*}
-\ln\left[\mathbb{P}\left(Y=y_{n}\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right] & =\mathbb{I}_{(y_{n}=1)}\left\{ -\ln\left[\mathbb{P}\left(Y=1\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\right\} \\
 & \qquad\qquad\qquad+\mathbb{I}_{(y_{n}=-1)}\left\{ -\ln\left[\mathbb{P}\left(Y=-1\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\right\} \\
 & =\mathbb{I}_{(y_{n}=1)}\left\{ -\ln\left[\mathbb{P}\left(Y=1\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\right\} \\
 & \qquad\qquad\qquad+\mathbb{I}_{(y_{n}=-1)}\left\{ -\ln\left[1-\mathbb{P}\left(Y=1\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\right\} \\
 & =\mathbb{I}_{(y_{n}=1)}\left\{ -\ln\left[h(\boldsymbol{x}_{n})\right]\right\} +\mathbb{I}_{(y_{n}=-1)}\left\{ -\ln\left[1-h(\boldsymbol{x}_{n})\right]\right\} \\
 & =\mathbb{I}_{(y_{n}=1)}\ln\left[\frac{1}{h(\boldsymbol{x}_{n})}\right]+\mathbb{I}_{(y_{n}=-1)}\ln\left[\frac{1}{1-h(\boldsymbol{x}_{n})}\right]
\end{align*}

\end_inset

where 
\begin_inset Formula $\mathbb{I}_{(\cdot)}$
\end_inset

 is the indicator function.
 Inserting this into the general negative logarithmic likelihood function yields the wanted result:
\family typewriter

\begin_inset Formula 
\begin{align*}
\mathcal{L}(\boldsymbol{w}) & =-\frac{1}{N}\sum^{N}_{n=1}\ln\left[\mathbb{P}\left(Y=y_{n}\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\\
 & =\frac{1}{N}\sum^{N}_{n=1}-\ln\left[\mathbb{P}\left(Y=y_{n}\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\\
 & =\frac{1}{N}\sum^{N}_{n=1}\left[\mathbb{I}_{(y_{n}=1)}\ln\left[\frac{1}{h(\boldsymbol{x}_{n})}\right]+\mathbb{I}_{(y_{n}=-1)}\ln\left[\frac{1}{1-h(\boldsymbol{x}_{n})}\right]\right].
\end{align*}

