\end_layout

\begin_layout Standard
The exact same procedure is completed for the new encoding of the probability function:
\begin_inset Formula 
\begin{align*}
\mathbb{P}\left(Y=y_{n}\mid X=\boldsymbol{x}_{n}\right) & =\begin{cases}
\theta(\boldsymbol{w}^{\top}\boldsymbol{x}) & \text{, if }y=1\\
\theta(-\boldsymbol{w}^{\top}\boldsymbol{x}) & \text{, if }y=0
\end{cases}\\
 & =\left[\theta(\boldsymbol{w}^{\top}\boldsymbol{x})\right]^{y_{n}}\left[\theta(-\boldsymbol{w}^{\top}\boldsymbol{x})\right]^{1-y_{n}}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
That is,
 we again setup the corresponding negative logarithmic likelihood function
\begin_inset Formula 
\begin{align*}
\mathcal{L}(\boldsymbol{w}) & =-\frac{1}{N}\sum^{N}_{n=1}\ln\left[\mathbb{P}\left(Y=y_{n}\mid X=\boldsymbol{x}_{n};\boldsymbol{w}\right)\right]\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left\{ \ln\left[\theta(\boldsymbol{w}^{\top}\boldsymbol{x})^{y_{n}}\theta(-\boldsymbol{w}^{\top}\boldsymbol{x})^{1-y_{n}}\right]\right\} \\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left\{ y_{n}\ln\left[\theta(\boldsymbol{w}^{\top}\boldsymbol{x})\right]+(1-y_{n})\ln\left[\theta(-\boldsymbol{w}^{\top}\boldsymbol{x})\right]\right\} ,
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and calculate the gradient
\begin_inset Formula 
\begin{align*}
\nabla\mathcal{L}(\boldsymbol{w}) & =-\frac{1}{N}\sum^{N}_{n=1}\begin{bmatrix}y_{n}\frac{1}{1+\exp\left\{ -\boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\}(-x_{n1})+(1-y_{n})\frac{1}{1+\exp\left\{ \boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\exp\{\boldsymbol{w}^{\top}\boldsymbol{x}\}x_{n1}\\
y_{n}\frac{1}{1+\exp\left\{ -\boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\}(-x_{n2})+(1-y_{n})\frac{1}{1+\exp\left\{ \boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\exp\{\boldsymbol{w}^{\top}\boldsymbol{x}\}x_{n2}\\
\vdots\\
y_{n}\frac{1}{1+\exp\left\{ -\boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\}(-x_{nd})+(1-y_{n})\frac{1}{1+\exp\left\{ \boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\exp\{\boldsymbol{w}^{\top}\boldsymbol{x}\}x_{nd}
\end{bmatrix}\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left[\frac{1}{1+\exp\left\{ -\boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\right]\begin{bmatrix}\left(-\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\}y_{n}+(1-y_{n})\right)x_{n1}\\
\left(-\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\}y_{n}+(1-y_{n})\right)x_{n2}\\
\vdots\\
\left(-\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\}y_{n}+(1-y_{n})\right)x_{nd}
\end{bmatrix}\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left[\frac{1}{1+\exp\left\{ -\boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\right]\left(y_{n}(1-\exp\{-\boldsymbol{w}^{\top}\boldsymbol{x}\})+1\right)\boldsymbol{x}_{n}\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left[y_{n}+\frac{1}{1+\exp\left\{ -\boldsymbol{w}^{\top}\boldsymbol{x}\right\} }\right]\boldsymbol{x}_{n}\\
 & =-\frac{1}{N}\sum^{N}_{n=1}\left[y_{n}+\theta(\boldsymbol{w}^{\top}\boldsymbol{x})\right]\boldsymbol{x}_{n}.
\end{align*}

\end_inset


\end_layout

