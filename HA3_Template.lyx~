\begin_inset Formula 
\begin{align*}
\nabla l_{n}(\boldsymbol{w}) & =\begin{bmatrix}\frac{\partial\mathcal{L}}{\partial w_{1}} & \frac{\partial\mathcal{L}}{\partial w_{2}} & \cdots & \frac{\partial\mathcal{L}}{\partial w_{d}}\end{bmatrix}^{\top}\\
 & =\begin{bmatrix}\frac{1}{1+\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} }\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} (-y_{n}x_{n1})\\
\frac{1}{1+\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} }\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} (-y_{n}x_{n2})\\
\vdots\\
\frac{1}{1+\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} }\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} (-y_{n}x_{nd})
\end{bmatrix}\\
 & =-y_{n}\frac{\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} }{1+\exp\left\{ -y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} }\begin{bmatrix}x_{n1} & x_{n2} & \cdots & x_{nd}\end{bmatrix}^{\top}\\
 & =-\frac{y_{n}\boldsymbol{x}_{n}}{1+\exp\left\{ y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} },
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
which we insert into 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
eqref{eq:gg}
\end_layout

\end_inset

 to obtain the wanted result
\begin_inset Formula 
\begin{align*}
\mathcal{L}(\boldsymbol{w}) & =-\frac{1}{N}\sum^{N}_{n=1}\frac{y_{n}\boldsymbol{x}_{n}}{1+\exp\left\{ y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right\} }\\
 & =\frac{1}{N}\sum^{N}_{n=1}-y_{n}\boldsymbol{x}_{n}\frac{1}{1+\exp\left\{ -(-y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n})\right\} }\\
 & =\frac{1}{N}\sum^{N}_{n=1}-y_{n}\boldsymbol{x}_{n}\theta\left(-y_{n}\boldsymbol{w}^{\top}\boldsymbol{x}_{n}\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection
Gradient for 
\begin_inset Formula $0$
\end_inset

 and 
\begin_inset Formula $1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset ERT
status collapsed

\begin_layout Plain Layout
% Write your derivation here.
