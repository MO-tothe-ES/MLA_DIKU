\begin_layout Subsection
Input Whitening (18 points)
\end_layout

\begin_layout Subsubsection
(a)
\end_layout

\begin_layout Standard
Calculating we get
\begin_inset Formula 
\[
Var(x_{1})=Var(\hat{x_{1}})=1,
\]

\end_inset


\begin_inset Formula 
\begin{align*}
Var(x_{2}) & =Var\left(\sqrt{1-\epsilon^{2}}\hat{x_{1}}+\epsilon\hat{x}_{2}\right)\\
 & =(1-\epsilon^{2})Var(\hat{x_{1}})+\epsilon^{2}Var(\hat{x_{2}})+\left(\sqrt{1-\epsilon^{2}}\epsilon\right)Cov\left(\hat{x}_{1},\hat{x}_{2}\right)\\
 & =1-\epsilon^{2}+\epsilon^{2}\\
 & =1,
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we have used the independece of 
\begin_inset Formula $\hat{x}_{1}$
\end_inset

 and 
\begin_inset Formula $\hat{x}_{2}$
\end_inset

 implying 
\begin_inset Formula $Cov\left(\hat{x}_{1},\hat{x}_{2}\right)=0$
\end_inset

.
 Finally
\begin_inset Formula 
\begin{align*}
Cov(x_{1},x_{2}) & =Cov\left(\hat{x}_{1},\sqrt{1-\epsilon^{2}}\hat{x_{1}}+\epsilon\hat{x}_{2}\right)\\
 & =Cov\left(\hat{x}_{1},\sqrt{1-\epsilon^{2}}\hat{x_{1}}\right)+Cov\left(\hat{x}_{1},\epsilon\hat{x}_{2}\right)\\
 & =\sqrt{1-\epsilon^{2}}Var\left(\hat{x}_{1}\right)+\epsilon Cov\left(\hat{x}_{1},\hat{x}_{2}\right)\\
 & =\sqrt{1-\epsilon^{2}},
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we again used the independece of 
\begin_inset Formula $\hat{x}_{1}$
\end_inset

 and 
\begin_inset Formula $\hat{x}_{2}$
\end_inset

.
\end_layout

\begin_layout Subsubsection
(b)
\end_layout

\begin_layout Standard
Using that 
\begin_inset Formula $x_{2}=\sqrt{1-\epsilon^{2}}\hat{x_{1}}+\epsilon\hat{x}_{2}\iff\hat{x}_{2}=\frac{x_{2}}{\epsilon}-\frac{\sqrt{1-\epsilon^{2}}}{\epsilon}\hat{x}_{1}$
\end_inset

 we obtain (for 
\begin_inset Formula $\epsilon\neq0)$
\end_inset


\begin_inset Formula 
\begin{align*}
f(\boldsymbol{\hat{x}}) & =\hat{w}_{1}\hat{x}_{1}+\hat{w}_{2}\hat{x}_{2}\\
 & =\hat{w}_{1}x_{1}+\hat{w}_{2}\left(\frac{x_{2}}{\epsilon}-\frac{\sqrt{1-\epsilon^{2}}}{\epsilon}\hat{x}_{1}\right)\\
 & =\underbrace{\left(\hat{w}_{1}-\frac{\sqrt{1-\epsilon^{2}}}{\epsilon}\right)}_{w_{1}}x_{1}+\underbrace{\frac{\hat{w}_{2}}{\epsilon}}_{w_{2}}x_{2}.
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection
(c)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
f(\boldsymbol{\hat{x}})=1\cdot\hat{x}_{1}+1\cdot\hat{x}_{2}=\left(1-\frac{\sqrt{1-\epsilon^{2}}}{\epsilon}\right)x_{1}+\frac{1}{\epsilon}x_{2}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C_{min}=\left(1-\frac{\sqrt{1-\epsilon^{2}}}{\epsilon}\right)^{2}+\left(\frac{1}{\epsilon}\right)^{2},\quad\epsilon\neq0
\]

\end_inset


\end_layout

\begin_layout Subsubsection
(d)
\end_layout

\begin_layout Standard
Both terms in 
\begin_inset Formula $C_{min}$
\end_inset

 goes to infinity as 
\begin_inset Formula $\epsilon\rightarrow0$
\end_inset

 so
\begin_inset Formula 
\[
C_{min}\rightarrow\infty\text{ as }\epsilon\rightarrow0.
\]

\end_inset

 
\end_layout

\begin_layout Section
Hoeffding's Bound (15 points)
\end_layout

\begin_layout Standard
Firstly we repeat Hoeffding's inequality for convenience.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathbb{P}\left(\sum^{N}_{i=1}X_{i}-\mathbb{E}\left[\sum^{N}_{i=1}X_{i}\right]\geq\epsilon\right)\leq\exp\left\{ -\frac{2\epsilon^{2}}{\sum^{N}_{i=1}(b_{i}-a_{i})^{2}}\right\} .\label{eq:hoeff}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Immediately we have 
\begin_inset Formula $X\in[-2,1]$
\end_inset

,
 so we choose 
\begin_inset Formula $a=-2$
\end_inset

 and 
\begin_inset Formula $b=1$
\end_inset

.
 
\begin_inset Formula $\epsilon$
\end_inset

 is determined by the condition 
\begin_inset Formula 
\[
S\geq22\iff S-\mathbb{E}\left[S\right]\geq22-\mathbb{E}\left[S\right]=\epsilon,
\]

\end_inset

where 
\begin_inset Formula $S=\sum^{100}_{i=1}X$
\end_inset

.
 So we calculate the expected value of 
\begin_inset Formula $S$
\end_inset

:
\begin_inset Formula 
\[
\mathbb{E}\left[S\right]=\sum^{100}_{i=1}\mathbb{E}\left[X\right]=\frac{100}{3}\left(-2+0.8+1\right)=-\frac{100}{15}.
\]

\end_inset


\end_layout

\begin_layout Standard
That is 
\begin_inset Formula $\epsilon=22-\left(-\frac{100}{15}\right)=\frac{22\cdot15+100}{15}\geq\epsilon$
\end_inset

.
 Inserting this into 
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
label{hoeff}
\end_layout

\end_inset

 yields the probability bound
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathbb{P}\left(S>22\right)\leq\mathbb{P}\left(S\geq22\right)\leq\exp\left\{ -\frac{2\cdot\left(\frac{22\cdot15+100}{15}\right)^{2}}{100\cdot3^{2}}\right\} \approx0.161.
\]

\end_inset


\end_layout

