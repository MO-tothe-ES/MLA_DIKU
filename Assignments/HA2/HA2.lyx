\begin_layout Paragraph
3.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathbb{P}\left(M_{20}\geq\alpha\right)\leq\frac{\mathbb{E}\left[M_{20}\right]}{\alpha}=\frac{0.35}{\alpha}
\]

\end_inset


\end_layout

\begin_layout Paragraph
4.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\mathbb{P}\left(M_{20}\geq\alpha\right) & =\mathbb{P}\left(M_{20}-\mathbb{E}\left[M_{20}\right]\geq\alpha-\mathbb{E}\left[M_{20}\right]\right)\\
 & \mathbb{P}\left(\sum^{20}_{i=1}X_{i}-\mathbb{E}\left[\sum^{20}_{i=1}X_{i}\right]\geq20\left(\alpha-\mathbb{E}\left[M_{20}\right]\right)\right)\\
 & \leq\mathbb{P}\left(|M_{20}-\mathbb{E}\left[M_{20}\right]|\geq20\left(\alpha-\mathbb{E}\left[M_{20}\right]\right)\right)\\
 & \leq\frac{\mathbb{V}\left(M_{20}\right)}{\left(20\left(\alpha-\mathbb{E}\left[M_{20}\right]\right)\right)^{2}}\\
 & =\frac{0.35(1-0.35)}{\left(20(\alpha-0.35)\right)^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Paragraph
5.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\mathbb{P}\left(M_{20}\geq\alpha\right) & =\mathbb{P}\left(M_{20}-\mathbb{E}\left[M_{20}\right]\geq\alpha-\mathbb{E}\left[M_{20}\right]\right)\\
 & =\mathbb{P}\left(\sum^{20}_{i=1}X_{i}-\mathbb{E}\left[\sum^{20}_{i=1}X_{i}\right]\geq20\left(\alpha-\mathbb{E}\left[M_{20}\right]\right)\right)\\
 & \leq\exp\left\{ -\frac{2\left(20\left(\alpha-\mathbb{E}\left[M_{20}\right]\right)\right)^{2}}{\sum^{20}_{i=1}\left(1-0\right)^{2}}\right\} \\
 & =\exp\left\{ -40\left(\alpha-\mathbb{E}\left[M_{20}\right]\right)^{2}\right\} 
\end{align*}

\end_inset


