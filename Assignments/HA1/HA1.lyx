\begin_layout Plain Layout
def knn(train_points,
 train_labels,
 test_points,
 test_labels,
 seed=56):
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    rng = np.random.default_rng(seed)
\end_layout

\begin_layout Plain Layout
    
\end_layout

\begin_layout Plain Layout
    m = len(train_labels) # number of training datapoints
\end_layout

\begin_layout Plain Layout
    n = len(test_labels) # number of test datapoints
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # distance matrix
\end_layout

\begin_layout Plain Layout
    train_sqn  = np.diag(train_points.T @ train_points).reshape(m,1)
\end_layout

\begin_layout Plain Layout
    test_sqn   = np.diag(test_points.T @ test_points).reshape(n,1)
\end_layout

\begin_layout Plain Layout
    trainTtest = training_points.T @ test_points
\end_layout

\begin_layout Plain Layout
	ones = lambda q:
 np.ones(q).reshape(q,1)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    D = (
\end_layout

\begin_layout Plain Layout
        train_sqn @ ones(n).T 
\end_layout

\begin_layout Plain Layout
        - 2*trainTtest 
\end_layout

\begin_layout Plain Layout
        + ones(m) @ test_sqn.T
\end_layout

\begin_layout Plain Layout
    )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # distance sorting
\end_layout

\begin_layout Plain Layout
    D_sort_index  = np.argsort(D,axis=0)
\end_layout

\begin_layout Plain Layout
    sorted_labels = training_labels[D_sort_index]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # predictions
\end_layout

\begin_layout Plain Layout
    sorted_labels_cumsum= sorted_labels.cumsum(axis=0)
\end_layout

\begin_layout Plain Layout
    pred = np.sign(sorted_labels_cumsum)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # randomly assign -1 or 1 wherever there is a tie
\end_layout

\begin_layout Plain Layout
    ties = pred == 0
\end_layout

\begin_layout Plain Layout
    pred[ties] = rng.choice([-1,
 1],
 size=ties.sum())
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # predictions errors and average errors
\end_layout

\begin_layout Plain Layout
    error     = pred != test_labels
\end_layout

\begin_layout Plain Layout
    avg_error = np.mean(error,axis=1)
\end_layout

\begin_layout Plain Layout
    
\end_layout

\begin_layout Plain Layout
    return avg_error
\end_layout

\end_inset


\end_layout

