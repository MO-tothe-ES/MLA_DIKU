\begin_layout Standard
Let the two point be 
\begin_inset Formula $\{(x_{1},y_{1}),(x_{2},y_{2})\}=\{(0,2),(0,1)\}$
\end_inset

 then the first problem is
\begin_inset Formula 
\[
b^{*}=\arg\min_{a,b}\sum^{2}_{i=1}\left(y_{i}-h(x_{i})\right)^{2}=\arg\min_{b}\left\{ \left(2-\exp(b)\right)^{2}+\left(1-\exp(b)\right)^{2}\right\} ,
\]

\end_inset


\end_layout

\begin_layout Standard
with the first order condition (FOC) yielding 
\begin_inset Formula $b^{*}$
\end_inset


\begin_inset Formula 
\begin{align*}
-2\left(2-\exp(b^{*})\right)\exp(b^{*})-2\left(1-\exp(b^{*})\right)\exp(b^{*}) & =-2\exp(b^{*})\left(3-2\exp(b^{*})\right)=0\iff\\
b^{*} & =\ln\frac{3}{2}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The second problem is
\begin_inset Formula 
\[
\beta^{*}=\arg\min_{\alpha,\beta}\sum^{2}_{i=1}\left(\ln y_{i}-(\alpha x_{i}+\beta)\right)^{2}=\arg\min_{\beta}\left\{ \left(\ln2-\beta\right)^{2}+\left(\ln1-\beta\right)^{2}\right\} ,
\]

\end_inset


\end_layout

\begin_layout Standard
with the FOC yielding 
\begin_inset Formula $\beta^{*}$
\end_inset


\begin_inset Formula 
\begin{align*}
-2\left(\ln2-\beta^{*}\right)-2\left(\ln1-\beta^{*}\right) & =-2\left(\ln2-2\beta^{*}\right)=0\iff\\
\beta^{*} & =\frac{\ln2}{2}=\ln\sqrt{2}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $\sqrt{2}$
\end_inset

 is an irrational number,
 and thus not equal to 
\begin_inset Formula $3/2$
\end_inset

,
 and 
\begin_inset Formula $\ln(\cdot)$
\end_inset

 is a strictly increasing function,
 and thus one-to-one,
 we can safely state that 
\begin_inset Formula $b^{*}\neq\beta^{*}$
\end_inset

.
\end_layout

