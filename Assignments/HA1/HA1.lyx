def reg(X,y):
\end_layout

\begin_layout Plain Layout
    # assuming X is N x (k+1)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # estimating the parameters
\end_layout

\begin_layout Plain Layout
    b = (
\end_layout

\begin_layout Plain Layout
        np.linalg.inv(X.T @ X) @ 
\end_layout

\begin_layout Plain Layout
        X.T @ y
\end_layout

\begin_layout Plain Layout
    )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # calculating predicted PCB values
\end_layout

\begin_layout Plain Layout
    y_pred = np.exp(X @ b)
\end_layout

\begin_layout Plain Layout
    y_raw  = np.exp(y)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    # calculating MSE and R^2
\end_layout

\begin_layout Plain Layout
    MSE = np.mean((y_raw-y_pred)**2)
\end_layout

\begin_layout Plain Layout
    R2 = 1 - MSE / np.sum((y_raw-np.mean(y_raw))**2)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
    return b,
 MSE,
 R2
\end_layout

\end_inset


\end_layout

